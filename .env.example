# ==============================================================================
# GraphQL-Powered E-Commerce Storefront - Environment Variables
# ==============================================================================

# Backend API Configuration
API_PORT=4000
NODE_ENV=production
FAKESTORE_API_URL=https://fakestoreapi.com

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# Client-side exposed API URL for GraphQL requests
# Inside browser, requests point to http://localhost:4000/graphql
VITE_API_PORT=4000
VITE_API_URL=http://localhost:4000/graphql
